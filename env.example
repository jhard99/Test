# Copy to .env and fill in (`cp env.example .env`). Never commit the real .env.
# The CLI loads .env automatically if it exists.

# --- Claude ---
# Two ways to authenticate; you only need one.
#
# 1. A Claude subscription, no API key (works if your org doesn't allow API
#    access): run `ant auth login` once. It stores an OAuth profile under
#    ~/.config/anthropic/ that the SDK finds on its own, and this file needs no
#    Claude entry at all. `ainews check` will confirm it.
#
# 2. An API key: uncomment the line below and paste it in.
#
# LEAVE THE LINE BELOW COMMENTED OUT IF YOU USE `ant auth login`. Profiles are
# only consulted when no API key is set, and *any* value wins that slot -
# including the placeholder `sk-ant-...` and even an empty string. A key set
# here silently shadows a perfectly good profile and the run fails to
# authenticate.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Newsletter inbox (IMAP) ---
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), not
# your account password, and keep 2FA on.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=app-password-here
# Optional: a dedicated label/folder you filter newsletters into.
IMAP_FOLDER=INBOX

# --- Reddit (optional) ---
# Reddit's robots.txt disallows anonymous reads, so the reddit source uses the
# OAuth API and needs a free registered app. Go to
# https://www.reddit.com/prefs/apps -> "create another app..." -> type "script".
# The client id is the string under the app name; the secret is next to it.
# Leave both unset and the reddit source sits the run out.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Delivery (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password-here
DIGEST_FROM=you@example.com
DIGEST_TO=you@example.com

# --- Subscription sites (optional) ---
# Path to a Netscape-format cookies.txt exported from the browser profile where
# you are already logged in to your NYT / WSJ / Atlantic subscriptions. Used to
# read full article text for the sites listed under `http.cookie_domains` in
# config.yaml. Leave unset to run headlines-and-abstracts only.
NEWS_COOKIES_FILE=
